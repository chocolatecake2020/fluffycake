VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Payment mode for the platform
#   p2p       : Clinic and Reviewer settle directly via PayPal; Admin confirms.
#   platform  : Use built-in checkout (Stripe / PayPal Checkout / USDT / Bank).
#   both      : Both options shown; clinic chooses.
# Default: p2p (suitable for closed pilot without business registration)
VITE_PAYMENT_MODE=p2p

# Platform fee shown only when mode != p2p
VITE_PLATFORM_FEE_USD=4.99
VITE_CASE_PRICE_USD=4.99

# Used only when VITE_PAYMENT_MODE includes "platform"
VITE_PAYMENTS_API_BASE_URL=
VITE_STRIPE_PAYMENT_LINK=
VITE_PAYPAL_PAYMENT_LINK=
