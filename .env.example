VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Payment mode for the platform
#   p2p       : Case page uses PayPal Checkout (Orders API) → capture on return; funds go to the PayPal business tied to PAYPAL_CLIENT_ID (e.g. vetbridgesupport@gmail.com).
#   platform  : Also enables the /payments lab UI for Stripe / other methods.
#   both      : Both.
# Default: p2p
VITE_PAYMENT_MODE=p2p

# Case checkout price (USD) and platform fee used in payout math (reviewer net ≈ gross − fee).
VITE_CASE_PRICE_USD=35
# Example: ~4,000 KRW of ~49,000 KRW total at ~1,400 KRW/USD ≈ 2.86 USD
VITE_PLATFORM_FEE_USD=2.86

# Required on Vercel for PayPal Checkout from the case page (same origin works):
#   VITE_PAYMENTS_API_BASE_URL=/api/payments
# Or full URL: https://YOUR_PROJECT.vercel.app/api/payments
VITE_PAYMENTS_API_BASE_URL=/api/payments

# Optional fallbacks when VITE_PAYMENTS_API_BASE_URL is empty (local mock only)
VITE_STRIPE_PAYMENT_LINK=
VITE_PAYPAL_PAYMENT_LINK=

# Vercel / server-only (set in Vercel Environment Variables, not VITE_*):
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com   # sandbox
# PAYPAL_API_BASE=https://api-m.paypal.com           # live
# PAYPAL_ENV=live
# Optional overrides:
# PAYPAL_RETURN_URL=https://your.app/payments?caseId=...  # usually omit; server builds return URL with caseId
# STRIPE_SECRET_KEY=  # if using Stripe in checkout-session.js
